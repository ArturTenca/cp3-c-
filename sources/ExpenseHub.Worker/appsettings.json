{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "ExpenseHub": "Data Source=../ExpenseHub.Api/expensehub.db;Default Timeout=30"
  },
  "RabbitMq": {
    "HostName": "localhost",
    "Port": 5672,
    "QueueName": "expensehub.reports"
  },
  "ReportProcessing": {
    "MaxAttempts": 3,
    "TransientRetryDelaySeconds": 5
  }
}
