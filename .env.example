# Copie para .env (que NÃO é versionado) e preencha. Senhas: mínimo 6 caracteres com maiúscula, minúscula, número e símbolo.
# Imagens publicadas pelo workflow "images" (tag = SHA completo do commit final).
# Troque OWNER pelo usuário/organização do GitHub em minúsculas e SHA pelo commit.
WEB_IMAGE=ghcr.io/OWNER/expensehub-web:SHA
WORKER_IMAGE=ghcr.io/OWNER/expensehub-worker:SHA

RABBITMQ_USER=expensehub
RABBITMQ_PASSWORD=

ADMIN_EMAIL=admin@expensehub.local
ADMIN_PASSWORD=
